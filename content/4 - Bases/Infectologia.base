views:
  - type: cards
    name: Doenças
    filters:
      and:
        - área.contains("Infectologia")
        - tipo.contains("Doença")
    sort:
      - property: file.ctime
        direction: DESC
    image: note.card
    cardSize: 290
    imageAspectRatio: 0.8
  - type: cards
    name: Doenças Bacterianas
    filters:
      and:
        - área.contains("Infectologia")
        - note["tipo de doença"].contains("Doença Bacteriana")
    image: note.card
  - type: cards
    name: Doenças Virais
    filters:
      and:
        - file.path.contains("1.2 Doenças e Condições")
        - note["tipo de doença"].contains("Doença Viral")
    image: note.card
  - type: cards
    name: Doenças Parasitárias
    filters:
      and:
        - file.path.containsAny("1.2 Doenças e Condições")
        - note["tipo de doença"].contains("Doença Parasitária")
    image: note.card
  - type: cards
    name: Infectologia Geral
    filters:
      and:
        - área.contains("Infectologia")
    image: note.card
