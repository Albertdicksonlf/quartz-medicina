views:
  - type: cards
    name: Tabela
    filters:
      and:
        - área.contains("Hematologia")
    image: note.card
  - type: table
    name: Aulas - Hematologia
    filters:
      and:
        - file.path.contains("3.1 Notas de Aulas")
        - área.contains("Hematologia")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
