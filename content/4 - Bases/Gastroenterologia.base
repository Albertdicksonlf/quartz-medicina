views:
  - type: cards
    name: Gastroenterologia - Doenças
    filters:
      and:
        - file.path.containsAny("Doenças")
        - área.contains("Gastroenterologia")
    sort:
      - property: file.name
        direction: ASC
    image: note.card
    imageAspectRatio: 0.55
  - type: cards
    name: Gastroenterologia - Terapêutica
    filters:
      and:
        - file.path.contains("Terapêutica")
        - área.contains("Gastroenterologia")
    groupBy:
      property: file.folder
      direction: ASC
    sort: []
    image: note.card
    imageAspectRatio: 0.65
  - type: cards
    name: Gastroenterologia - Exames
    filters:
      and:
        - file.path.contains("Exames")
        - área.contains("Gastroenterologia")
    image: note.card
    imageAspectRatio: 0.7
  - type: cards
    name: Gastroenterologia - Sintomas e Síndromes
    filters:
      and:
        - file.path.contains("1.1 Guias de Raciocínio - Sintomas")
        - área.containsAny("Gastroenterologia")
    sort:
      - property: file.mtime
        direction: DESC
    image: note.card
